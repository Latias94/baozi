{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Baozi scale profile policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_schema",
    "profile_id",
    "execution",
    "criterion",
    "rss",
    "cases"
  ],
  "properties": {
    "schema": { "const": "baozi-scale-policy/v1" },
    "artifact_schema": { "const": "baozi-scale-report/v1" },
    "profile_id": { "const": "u3-obj-import-v1" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_timeout_seconds",
        "tool_timeout_seconds",
        "metadata_timeout_seconds",
        "criterion_timeout_seconds",
        "probe_build_timeout_seconds",
        "max_stdout_bytes",
        "max_stderr_bytes"
      ],
      "properties": {
        "collection_timeout_seconds": { "type": "integer", "minimum": 1 },
        "tool_timeout_seconds": { "type": "integer", "minimum": 1 },
        "metadata_timeout_seconds": { "type": "integer", "minimum": 1 },
        "criterion_timeout_seconds": { "type": "integer", "minimum": 1 },
        "probe_build_timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_stdout_bytes": { "type": "integer", "minimum": 1 },
        "max_stderr_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "expected_source",
        "benchmark_group",
        "warm_up_seconds",
        "measurement_seconds",
        "sample_size",
        "resamples",
        "time_slope_advisory_exponent"
      ],
      "properties": {
        "expected_version": { "const": "0.5.1" },
        "expected_source": {
          "const": "registry+https://github.com/rust-lang/crates.io-index"
        },
        "benchmark_group": { "const": "obj_face_import_scale" },
        "warm_up_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "measurement_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "sample_size": { "type": "integer", "minimum": 10 },
        "resamples": { "type": "integer", "minimum": 1 },
        "time_slope_advisory_exponent": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "repetitions",
        "probe_timeout_seconds",
        "growth_factor_per_decade",
        "growth_slack_bytes",
        "ledger_multiplier",
        "fixed_allowance_bytes",
        "max_rss_bytes"
      ],
      "properties": {
        "tool": { "const": "/usr/bin/time" },
        "repetitions": { "type": "integer", "minimum": 1 },
        "probe_timeout_seconds": { "type": "integer", "minimum": 1 },
        "growth_factor_per_decade": { "type": "number", "minimum": 1 },
        "growth_slack_bytes": { "type": "integer", "minimum": 0 },
        "ledger_multiplier": { "type": "number", "minimum": 1 },
        "fixed_allowance_bytes": { "type": "integer", "minimum": 0 },
        "max_rss_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "scales", "selected_1000x", "fixture"],
        "properties": {
          "case_id": { "const": "obj_repeated_triangle_faces" },
          "scales": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          },
          "selected_1000x": { "const": true },
          "fixture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base_face_count",
              "peak_fixed_bytes",
              "peak_bytes_per_input_byte",
              "peak_bytes_per_face"
            ],
            "properties": {
              "base_face_count": { "type": "integer", "minimum": 1 },
              "peak_fixed_bytes": { "type": "integer", "minimum": 0 },
              "peak_bytes_per_input_byte": { "type": "integer", "minimum": 0 },
              "peak_bytes_per_face": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
