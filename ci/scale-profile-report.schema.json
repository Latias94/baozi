{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Baozi scale profile report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_mode",
    "status",
    "profile_id",
    "started_at",
    "finished_at",
    "git",
    "runner",
    "tools",
    "policy",
    "samples",
    "time_slopes",
    "checks",
    "advisory_regressions",
    "failure"
  ],
  "properties": {
    "schema": { "const": "baozi-scale-report/v1" },
    "execution_mode": { "enum": ["collection", "validate_only"] },
    "status": { "enum": ["passed", "failed", "error"] },
    "profile_id": { "const": "u3-obj-import-v1" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "collection_deadline_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "ref", "run_id", "run_attempt"],
      "properties": {
        "sha": { "type": "string" },
        "ref": { "type": "string" },
        "run_id": { "type": "string" },
        "run_attempt": { "type": "string" }
      }
    },
    "runner": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch", "image"],
          "properties": {
            "os": { "type": "string" },
            "arch": { "type": "string" },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": ["os", "version"],
              "properties": {
                "os": { "type": "string" },
                "version": { "type": "string" }
              }
            },
            "os_description": { "type": "string" },
            "kernel": { "type": "string" },
            "cpu": {
              "type": "object",
              "additionalProperties": false,
              "required": ["logical_processors", "lscpu"],
              "properties": {
                "logical_processors": { "type": "integer", "minimum": 1 },
                "lscpu": { "type": "array" }
              }
            }
          }
        }
      ]
    },
    "tools": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rustc", "cargo", "criterion", "gnu_time"],
          "properties": {
            "rustc": { "type": ["string", "null"] },
            "cargo": { "type": ["string", "null"] },
            "gnu_time": { "type": ["string", "null"] },
            "criterion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expected_version",
                "actual_version",
                "expected_source",
                "actual_source"
              ],
              "properties": {
                "expected_version": { "type": "string" },
                "actual_version": { "type": ["string", "null"] },
                "expected_source": { "type": "string" },
                "actual_source": { "type": ["string", "null"] }
              }
            }
          }
        }
      ]
    },
    "policy": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "sha256"],
          "properties": {
            "schema": { "const": "baozi-scale-policy/v1" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "scale",
          "logical_units",
          "input_bytes",
          "criterion",
          "process",
          "ledger"
        ],
        "properties": {
          "case_id": { "type": "string" },
          "scale": { "type": "integer", "minimum": 0 },
          "logical_units": { "type": "integer", "minimum": 0 },
          "input_bytes": { "type": "integer", "minimum": 0 },
          "criterion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "median_nanoseconds",
              "confidence_lower_nanoseconds",
              "confidence_upper_nanoseconds",
              "sample_count"
            ],
            "properties": {
              "median_nanoseconds": { "type": "number", "exclusiveMinimum": 0 },
              "confidence_lower_nanoseconds": { "type": "number", "exclusiveMinimum": 0 },
              "confidence_upper_nanoseconds": { "type": "number", "exclusiveMinimum": 0 },
              "sample_count": { "type": "integer", "minimum": 1 }
            }
          },
          "process": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_rss_bytes",
              "rss_repetitions_bytes",
              "idle_probe_min_rss_bytes",
              "idle_probe_max_rss_bytes",
              "idle_probe_repetitions_bytes",
              "rss_delta_bytes"
            ],
            "properties": {
              "max_rss_bytes": { "type": "integer", "minimum": 0 },
              "rss_repetitions_bytes": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 }
              },
              "idle_probe_min_rss_bytes": { "type": "integer", "minimum": 0 },
              "idle_probe_max_rss_bytes": { "type": "integer", "minimum": 0 },
              "idle_probe_repetitions_bytes": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 }
              },
              "rss_delta_bytes": { "type": "integer", "minimum": 0 }
            }
          },
          "ledger": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current_live_bytes",
              "peak_live_bytes",
              "active_reservations",
              "current_evidence_bytes",
              "reviewed_peak_live_envelope_bytes",
              "peak_evidence_bytes",
              "canonical_output_committed"
            ],
            "properties": {
              "current_live_bytes": { "type": "integer", "minimum": 0 },
              "peak_live_bytes": { "type": "integer", "minimum": 0 },
              "active_reservations": { "type": "integer", "minimum": 0 },
              "current_evidence_bytes": { "type": "integer", "minimum": 0 },
              "reviewed_peak_live_envelope_bytes": { "type": "integer", "minimum": 0 },
              "peak_evidence_bytes": { "type": "integer", "minimum": 0 },
              "canonical_output_committed": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "time_slopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_scale",
          "to_scale",
          "exponent",
          "advisory_limit",
          "passed"
        ],
        "properties": {
          "from_scale": { "type": "integer", "minimum": 1 },
          "to_scale": { "type": "integer", "minimum": 1 },
          "exponent": { "type": "number" },
          "advisory_limit": { "type": "number" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "passed", "observed", "limit", "unit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["hard", "advisory"] },
          "passed": { "type": "boolean" },
          "observed": {},
          "limit": {},
          "unit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "advisory_regressions": { "type": "integer", "minimum": 0 },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness_outcome", "collection_outcome"],
      "properties": {
        "correctness_outcome": { "type": "string" },
        "collection_outcome": { "type": "string" }
      }
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "exception_type", "message", "message_truncated"],
          "properties": {
            "step": { "type": "string", "minLength": 1 },
            "exception_type": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "message_truncated": { "type": "boolean" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": {
        "properties": {
          "runner": { "type": "object" },
          "tools": { "type": "object" },
          "policy": { "type": "object" },
          "failure": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "properties": { "failure": { "type": "object" } } }
    }
  ]
}
